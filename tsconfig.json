{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "rootDir": ".",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": [
    "src/**/*",
    "shared/**/*",
    "test/**/*"
  ],
  "exclude": [
    "node_modules",
    "out",
    "webview"
  ]
}
